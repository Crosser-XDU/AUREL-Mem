OPENAI_API_KEY=replace-me
# OpenAI-compatible gateway used for this prototype; not an official OpenAI host.
# Change this URL if you use a different compatible provider.
OPENAI_API_BASE=https://api.gpt.ge/v1
OPENAI_MODEL=gpt-4o-mini
# A compatible embedding provider must expose text-embedding-v4.
# This model name is not an OpenAI official embedding model.
# Empty embedding base/key inherit the chat gateway and key.
EMBEDDING_ENABLED=true
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL=text-embedding-v4
OPENAI_EMBEDDING_DIMENSIONS=1024
MEMORY_DB=data/memory.sqlite3
# Generate a separate random service token; never use the upstream model key here.
MEMORY_API_TOKEN=replace-with-a-random-service-token
LLM_CONCURRENCY=4
UPSTREAM_TIMEOUT=60
RETRIEVAL_LIMIT=32
NEIGHBOR_HOPS=1
GRAPH_EXPANSION=true
DIVERSITY=true
MAX_RESPONSE_IMAGES=12
MAX_RESPONSE_TEXT_CHARS=100000
